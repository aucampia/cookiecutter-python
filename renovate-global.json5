{
    // https://docs.renovatebot.com/self-hosted-experimental/
    // https://docs.renovatebot.com/self-hosted-configuration/
    "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
    "platform": "github",
    "repositoryCache": "enabled",
    // The config is in the global config file (i.e. this file)
    "requireConfig": "optional",
    "onboarding": false,
    "allowedCommands": [
        ".*",
    ],
    // `allowedUnsafeExecutions` is deliberately unset. Refreshing mise.lock
    // means running `mise lock`, which can run repository-defined behaviour.
    // While mise is not allowlisted Renovate runs it with `MISE_SAFE=1` and
    // without `mise trust`, which is a hard boundary against that; allowlisting
    // "mise" takes the trust-then-lock path instead. Needs mise >= 2026.7.12,
    // below which Renovate blocks mise entirely rather than running it unsafe.
    // devtools/renovate/postprocess.sh reads this report to find the PRs it
    // has to approve, and the workflow uploads it as an artifact.
    "reportPath": "/tmp/renovate/report.json",
    "reportType": "file",
    "repositories": [
        {
            "repository": "aucampia/cookiecutter-python",
            // https://docs.renovatebot.com/config-overview/
            // https://docs.renovatebot.com/configuration-options/
            // https://docs.renovatebot.com/modules/manager/
            "extends": [
                "config:recommended",
                // Direct PyPI bumps have to be 3 days old before Renovate
                // proposes them, so a yanked or compromised release has time
                // to be pulled. The preset's `internalChecksFilter: "strict"`
                // filters the candidate out entirely instead of parking a PR,
                // which matters here: everything automerges, so a parked PR
                // would just hold a `prConcurrentLimit` slot for three days.
                // This only covers updates that edit a pyproject.toml
                // constraint - the preset exempts `lockfileUpdate`, and
                // transitive deps in uv.lock are never age-gated.
                "security:minimumReleaseAgePypi",
            ],
            "labels": [
                "dependencies"
            ],
            "vulnerabilityAlerts": {
                "enabled": true,
            },
            "pinDigests": true,
            "osvVulnerabilityAlerts": true,
            // Enum: "none" | "all" | "unresolved" - `true` was silently
            // rejected by config validation.
            "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
            "prConcurrentLimit": 5,
            // https://docs.renovatebot.com/modules/manager/
            // "mise" covers .mise.toml + mise.lock. "gomod", "dockerfile",
            // "pip-compile" and "pip_requirements" were dropped along with the
            // devtools Go/Dockerfile toolchain they used to match.
            "enabledManagers": [
                "pep621",
                "github-actions",
                "docker-compose",
                "mise",
            ],
            "lockFileMaintenance": {
                "enabled": true,
                "schedule": [
                    "* * * * *"
                ],
            },
            "automerge": true,
            "automergeStrategy": "squash",
            "platformAutomerge": true,
            "rebaseWhen": "conflicted",
            // By default Renovate only posts the artifact status check when an
            // artifact update failed, so a green result never exists and the
            // check can't be made required. "always" posts green too, so a
            // uv.lock/mise.lock that Renovate failed to refresh can block the
            // merge instead of riding along with platformAutomerge.
            "statusCheckWhen": {
                "artifactError": "always",
            },
            "packageRules": [
                {
                    "matchManagers": [
                        "pep621"
                    ],
                    "rangeStrategy": "update-lockfile"
                }
            ]
        }
    ]
}
